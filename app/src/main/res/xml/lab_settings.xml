<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/lab_warning"
        app:allowDividerAbove="false">

        <Preference
            android:key="lab_warning_description"
            android:title="@string/lab_warning_title"
            android:summary="@string/lab_warning_description"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lab_features"
        app:allowDividerAbove="true">

        <com.hippo.ehviewer.ui.fragment.lab.LabPreference
            android:key="lab_ip_switch"
            android:title="@string/lab_ip_switch"
            android:summary="@string/lab_ip_switch_summary"
            app:fragment="com.hippo.ehviewer.ui.fragment.lab.IpSwitchFragment" />

        <com.hippo.ehviewer.ui.fragment.lab.LabPreference
            android:key="lab_ai_translate"
            android:title="@string/lab_ai_translate"
            android:summary="@string/lab_ai_translate_summary"
            app:fragment="com.hippo.ehviewer.ui.fragment.lab.AiTranslateFragment" />

        <com.hippo.ehviewer.ui.fragment.lab.LabPreference
            android:key="lab_ai_analyze"
            android:title="@string/lab_ai_analyze"
            android:summary="@string/lab_ai_analyze_summary"
            app:fragment="com.hippo.ehviewer.ui.fragment.lab.AiAnalyzeFragment" />

        <com.hippo.ehviewer.ui.fragment.lab.LabPreference
            android:key="lab_semantic"
            android:title="@string/lab_semantic"
            android:summary="@string/lab_semantic_summary"
            app:fragment="com.hippo.ehviewer.ui.fragment.lab.SemanticSearchFragment" />

        <com.hippo.ehviewer.preference.ProgressiveManagerPreference
            android:key="lab_progressive_manager" />

        <com.hippo.ehviewer.preference.RelayCenterPreference
            android:key="lab_relay_center" />

        <com.hippo.ehviewer.preference.StorageAnalysisPreference
            android:key="lab_storage_analysis" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lab_sync_section"
        app:allowDividerAbove="true">

        <com.hippo.preference.ListPreference
            android:defaultValue="bidirectional"
            android:key="lab_sync_direction"
            android:summary="%s"
            android:title="@string/lab_sync_direction"
            app:entries="@array/lab_sync_direction_entries"
            app:entryValues="@array/lab_sync_direction_values" />

        <Preference
            android:key="lab_sync_hint"
            android:summary="@string/lab_sync_section_summary"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>