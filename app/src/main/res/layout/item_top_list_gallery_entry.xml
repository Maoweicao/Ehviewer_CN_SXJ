<?xml version="1.0" encoding="utf-8"?>
<!--
  画廊排行榜条目：左缩略图 + 右标题/uploader/评分/页数，右上角多选勾选角标。
  仅用于 gallery_toplists（唯一带 gid+token、能拉到画廊详情的分类）；
  其余 6 个关键词榜单继续用 item_top_list_entry.xml 的文字行。
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardView.Normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.hippo.ehviewer.widget.TileThumb
            android:id="@+id/gallery_thumb"
            android:layout_width="56dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:retryType="none"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gallery_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/textColorThemePrimary"
                android:textSize="14sp"
                tools:text="[Yoshimotto] Seishori ka no Kawakami san" />

            <TextView
                android:id="@+id/gallery_uploader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="Mios-dream" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hippo.ehviewer.widget.SimpleRatingView
                    android:id="@+id/gallery_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/gallery_pages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="120P" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/gallery_selected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:contentDescription="@null"
            android:src="@drawable/v_check_dark_x24"
            android:visibility="gone" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
