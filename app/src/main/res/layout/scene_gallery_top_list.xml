<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hippo.widget.ProgressView
        android:id="@+id/data_loading_view"
        style="@style/ProgressView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_detail_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/top_list_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/contentColorPrimary"
                app:tabIndicatorColor="?attr/widgetColorThemePrimary"
                app:tabIndicatorHeight="3dp"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="?attr/widgetColorThemePrimary"
                app:tabTextColor="?attr/textColorThemePrimary"></com.google.android.material.tabs.TabLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/top_list_sub_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_list_subtab_height"
                android:background="?attr/contentColorPrimary"
                app:tabGravity="fill"
                app:tabIndicatorColor="?attr/widgetColorThemeAccent"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="?attr/widgetColorThemeAccent"
                app:tabTextAppearance="@style/TextAppearance.AppCompat.Caption"
                app:tabTextColor="?attr/textColorThemePrimary"></com.google.android.material.tabs.TabLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/top_list_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="88dp"></androidx.recyclerview.widget.RecyclerView>

            <!-- 多选下载底部操作条，仅画廊排行榜可进入多选 -->
            <LinearLayout
                android:id="@+id/top_list_download_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/contentColorPrimary"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/top_list_download_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/textColorThemePrimary"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/top_list_download_action"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/top_list_download_cancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@android:string/cancel" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/empty_state_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(×_×)"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/empty_state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/top_list_empty"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                    <android.widget.Button
                        android:id="@+id/empty_state_retry"
                        style="@style/Widget.AppCompat.Button.Borderless.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/top_list_retry"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 浮动多选 FAB：脱离滚动容器，固定在右下角，不随列表滚动 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/top_list_multi_select_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/multi_select_mode_enabled"
        android:visibility="gone"
        app:backgroundTint="?attr/widgetColorThemePrimary"
        app:srcCompat="@drawable/v_check_all_dark_x24" />

</FrameLayout>