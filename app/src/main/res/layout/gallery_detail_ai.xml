<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_analysis"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/keyline_margin"
    android:visibility="gone">

    <TextView
        android:id="@+id/ai_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_analysis_title"
        android:textStyle="bold"
        android:textColor="?attr/textColorThemeAccent"/>

    <TextView
        android:id="@+id/ai_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:id="@+id/ai_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:id="@+id/ai_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:id="@+id/ai_tags_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ai_analysis_tags"
        android:textStyle="bold"
        android:textColor="?attr/textColorThemeAccent"/>

    <TextView
        android:id="@+id/ai_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:id="@+id/ai_pages_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ai_analysis_page_details"
        android:textColor="?attr/textColorThemeAccent"/>

    <LinearLayout
        android:id="@+id/ai_pages_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/ai_analyze_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/ai_analysis_start"
        android:textColor="?attr/textColorThemeAccent"/>

</LinearLayout>
