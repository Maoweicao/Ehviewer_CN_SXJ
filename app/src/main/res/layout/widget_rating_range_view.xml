<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 启用复选框 -->
    <CheckBox
        android:id="@+id/enable_rating_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rating_range_enable"
        android:textSize="14sp" />

    <!-- 评分范围内容 -->
    <LinearLayout
        android:id="@+id/rating_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- 最低评分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_range_from"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <RatingBar
                android:id="@+id/rating_from_bar"
                style="?attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:isIndicator="false"
                android:numStars="5"
                android:stepSize="0.5" />

            <TextView
                android:id="@+id/from_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="32dp"
                android:text="0.0"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 最高评分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_range_to"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <RatingBar
                android:id="@+id/rating_to_bar"
                style="?attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:isIndicator="false"
                android:numStars="5"
                android:stepSize="0.5" />

            <TextView
                android:id="@+id/to_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="32dp"
                android:text="5.0"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</merge>
