<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/merged_gallery_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/merged_banner_background"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingStart="@dimen/keyline_margin"
        android:paddingEnd="@dimen/keyline_margin"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/v_merge_x24"
            android:tint="@color/merged_banner_foreground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/merged_gallery_banner"
            android:textColor="@color/merged_banner_foreground"
            android:textSize="14sp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            layout="@layout/gallery_detail_progress"/>

        <LinearLayout
            android:id="@+id/below_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?attr/galleryDetailDivider"
            android:showDividers="middle"
            android:dividerPadding="@dimen/keyline_margin">

            <include
                layout="@layout/gallery_detail_header"/>

            <include
                layout="@layout/gallery_detail_info"/>

            <include
                layout="@layout/gallery_detail_actions"/>

            <include
                layout="@layout/gallery_detail_tags"/>

            <include
                layout="@layout/gallery_detail_ai"/>

            <include
                layout="@layout/gallery_detail_comments"/>

            <include
                layout="@layout/gallery_detail_previews"/>
<!--            <include-->
<!--                layout="@layout/gallery_detail_progress"/>-->

        </LinearLayout>

    </FrameLayout>
</LinearLayout>
