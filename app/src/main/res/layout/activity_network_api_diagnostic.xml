<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Warning Banner -->
    <LinearLayout
        android:id="@+id/warning_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#33FF9800"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/api_diagnostic_warning"
            android:textSize="12sp"
            android:textColor="#FFCC6600" />
    </LinearLayout>

    <!-- Timeout Setting -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="?attr/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeout_label"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary" />

        <Spinner
            android:id="@+id/timeout_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:entries="@array/timeout_options"
            android:prompt="@string/timeout_prompt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeout_unit_seconds"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Site Tabs -->
    <LinearLayout
        android:id="@+id/site_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorSurface"
        android:gravity="center">

        <TextView
            android:id="@+id/tab_e_hentai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="E-Hentai"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:padding="8dp"
            android:background="#224CAF50"
            android:textColor="#FF4CAF50" />

        <TextView
            android:id="@+id/tab_ex_hentai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ex-Hentai"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:background="#229E9E9E"
            android:textColor="#FF9E9E9E" />
    </LinearLayout>

    <!-- Progress + Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ProgressBar
            android:id="@+id/diagnostic_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:indeterminate="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_diagnostic"
            android:textSize="13sp"
            android:visibility="gone"
            style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>

    <TextView
        android:id="@+id/diagnostic_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <!-- Expandable List -->
    <ExpandableListView
        android:id="@+id/expandable_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:groupIndicator="@null" />

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurface"
        android:gravity="center">

        <Button
            android:id="@+id/btn_expand_collapse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/expand_collapse_all"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_export_har"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/export_diagnostic_log"
            android:textSize="13sp"
            android:layout_marginStart="8dp"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
