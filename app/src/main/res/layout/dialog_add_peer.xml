<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="?attr/dialogPreferredPadding"
    android:paddingTop="@dimen/abc_dialog_padding_top_material"
    android:paddingRight="?attr/dialogPreferredPadding">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.hippo.widget.HackyTextInputEditText
            android:id="@+id/input_peer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/multi_device_add_name"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.hippo.widget.HackyTextInputEditText
            android:id="@+id/input_peer_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/multi_device_add_host"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.hippo.widget.HackyTextInputEditText
            android:id="@+id/input_peer_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/multi_device_add_port"
            android:inputType="number"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.hippo.widget.HackyTextInputEditText
            android:id="@+id/input_peer_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/multi_device_add_id_optional"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
