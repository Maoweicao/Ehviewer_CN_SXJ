<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 网络信息显示 -->
    <TextView
        android:id="@+id/network_info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="获取网络信息中..."
        android:textSize="14sp"
        android:textColor="?attr/colorOnBackground"
        android:padding="12dp"
        android:background="?attr/colorSurface"
        android:layout_marginBottom="16dp" />

    <!-- 超时设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeout_label"
            android:textSize="14sp"
            android:textColor="?attr/colorOnBackground" />

        <Spinner
            android:id="@+id/timeout_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:entries="@array/timeout_options"
            android:prompt="@string/timeout_prompt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeout_unit_seconds"
            android:textSize="14sp"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 进度条 + 取消按钮 -->
    <LinearLayout
        android:id="@+id/progress_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginVertical="16dp">

        <ProgressBar
            android:id="@+id/diagnostic_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:indeterminate="true" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_diagnostic"
            android:textSize="13sp"
            android:layout_marginStart="12dp"
            style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>

    <!-- 诊断结果容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/diagnostic_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
