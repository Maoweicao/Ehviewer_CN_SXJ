<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 标签 -->
    <TextView
        android:id="@+id/range_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <!-- 从输入框 -->
    <EditText
        android:id="@+id/range_from_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_text_underline"
        android:hint="@string/range_from_hint"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textSize="14sp" />

    <!-- 分隔符 -->
    <TextView
        android:id="@+id/range_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="@string/range_separator"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <!-- 到输入框 -->
    <EditText
        android:id="@+id/range_to_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_text_underline"
        android:hint="@string/range_to_hint"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textSize="14sp" />

    <!-- 单位 -->
    <TextView
        android:id="@+id/range_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

</merge>
