<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBox
        android:id="@+id/exclude_enable_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_exclude_enable" />

    <TextView
        android:id="@+id/exclude_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/filter_section_exclude_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/exclude_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/filter_exclude_categories"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <com.hippo.ehviewer.ui.scene.download.part.DownloadCategoryTable
            android:id="@+id/exclude_category_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/filter_exclude_keywords"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/exclude_scope_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="88dp" />

            <com.hippo.ehviewer.widget.TagInputView
                android:id="@+id/exclude_keyword_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="2"
                android:background="@drawable/bg_edit_text_underline"
                android:hint="@string/filter_exclude_keyword_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:padding="8dp" />

            <Button
                android:id="@+id/exclude_keyword_add"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="56dp"
                android:text="@string/filter_exclude_add"
                android:textAllCaps="false"
                android:textColor="?android:textColorPrimary" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/exclude_keyword_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:chipSpacingVertical="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/filter_exclude_tags"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.hippo.ehviewer.widget.TagInputView
                android:id="@+id/exclude_tag_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_underline"
                android:hint="@string/filter_exclude_tag_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:padding="8dp" />

            <Button
                android:id="@+id/exclude_tag_add"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="56dp"
                android:text="@string/filter_exclude_add"
                android:textAllCaps="false"
                android:textColor="?android:textColorPrimary" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/exclude_tag_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:chipSpacingVertical="4dp" />

        <TextView
            android:id="@+id/exclude_tag_coverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/exclude_clear_all"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/filter_exclude_clear_all" />

    </LinearLayout>

</merge>
