<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bench_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 设备信息卡 -->
        <LinearLayout
            android:id="@+id/bench_device_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/contentColorPrimary"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/bench_device_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/performance_benchmark_device_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bench_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 使用提示卡 -->
        <LinearLayout
            android:id="@+id/bench_tip_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/contentColorPrimary"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/bench_tip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/performance_benchmark_tip_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bench_tip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_benchmark_tip"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>

        <!-- 测试进行中状态 -->
        <LinearLayout
            android:id="@+id/bench_progress_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/bench_current_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/bench_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bench_run_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/performance_benchmark_run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bench_export_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/performance_benchmark_export" />
        </LinearLayout>

        <!-- 结果区 -->
        <TextView
            android:id="@+id/bench_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/performance_benchmark_result_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bench_results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
