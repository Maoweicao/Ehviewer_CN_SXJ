<?xml version="1.0" encoding="utf-8"?>
<!-- 表单样式的榜单条目：左侧保留金银铜排名 badge，右侧标题，底部细分隔线，无卡片外框。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/top_list_rank_container"
            android:layout_width="@dimen/top_list_entry_rank_size"
            android:layout_height="@dimen/top_list_entry_rank_size"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rank_normal">

            <TextView
                android:id="@+id/top_list_rank_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="#1" />

            <ImageView
                android:id="@+id/top_list_rank_crown"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/v_crown_white_x24"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 条目类型标记：人（上传者）/ 画廊（只有名称没有详情） -->
        <ImageView
            android:id="@+id/top_list_kind_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/ic_toplist_user"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/top_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/textColorThemePrimary"
            android:textSize="14sp"
            tools:text="[Yoshimotto] Seishori ka no Kawakami san [Dejitaruban Gentai Omake-tsuki]" />
    </LinearLayout>

    <com.hippo.ehviewer.widget.DividerView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:dividerColor="?attr/dividerColor" />

</LinearLayout>
