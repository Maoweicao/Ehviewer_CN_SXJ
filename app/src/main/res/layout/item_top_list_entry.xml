<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardView.Reactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/top_list_entry_margin_h"
    android:layout_marginVertical="@dimen/top_list_entry_margin_v"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/top_list_rank_container"
            android:layout_width="@dimen/top_list_entry_rank_size"
            android:layout_height="@dimen/top_list_entry_rank_size"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_rank_normal">

            <TextView
                android:id="@+id/top_list_rank_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="#1" />

            <ImageView
                android:id="@+id/top_list_rank_crown"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/v_crown_white_x24"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/top_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/textColorThemePrimary"
            android:textSize="14sp"
            tools:text="[Yoshimotto] Seishori ka no Kawakami san [Dejitaruban Gentai Omake-tsuki] [Chinese]" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
