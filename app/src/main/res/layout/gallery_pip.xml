<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pip_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1a1a1a"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/pip_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        tools:src="@android:drawable/ic_menu_gallery" />

    <!-- Top: title -->
    <LinearLayout
        android:id="@+id/pip_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/pip_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            tools:text="Gallery Title" />
    </LinearLayout>

    <!-- Bottom: prev | first | progress | play | next | restore -->
    <LinearLayout
        android:id="@+id/pip_control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center"
        android:padding="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pip_prev_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/pip_prev"
            android:padding="10dp"
            android:src="@drawable/v_arrow_left_dark_x24"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/pip_first_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="First page"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/pip_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="54dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:text="1 / 20" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/pip_play_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Play"
            android:padding="10dp"
            android:src="@drawable/v_play_x24"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/pip_next_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/pip_next"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/v_arrow_left_dark_x24"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/pip_restore_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="10dp"
            android:text="@string/pip_restore"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
