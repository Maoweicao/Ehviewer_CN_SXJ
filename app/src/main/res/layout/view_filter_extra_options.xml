<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <CheckBox
        android:id="@+id/extra_low_rating_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_extra_low_rating_only" />

    <TextView
        android:id="@+id/extra_posted_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/filter_extra_posted_range"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/extra_posted_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" />

    <CheckBox
        android:id="@+id/extra_unfavorited_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_extra_unfavorited" />

    <CheckBox
        android:id="@+id/extra_ai_generated_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_extra_ai_generated" />

    <CheckBox
        android:id="@+id/extra_tags_missing_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_extra_tags_missing" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/filter_extra_per_page"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/extra_per_page_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edit_text_underline"
        android:hint="@string/range_from_hint"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:padding="8dp" />

</merge>
